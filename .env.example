# =====================================================================
#  TSEC Placement Portal — settings
#  This file is copied to ".env" on first start. Edit .env, then restart
#  the server (Ctrl + C, then npm start).
# =====================================================================

# Port the website runs on  ->  http://localhost:3000
PORT=3000

# ---------------------------------------------------------------------
#  TPO login (created automatically the first time the server starts)
#  After the first start, change the password from the portal itself:
#  top-right menu -> Change password.
# ---------------------------------------------------------------------
TPO_EMAIL=tpo@tsec.edu
TPO_NAME=Training & Placement Cell
TPO_PASSWORD=Tsec@2026

# Only allow students to register with this email domain.
# Example: ALLOWED_EMAIL_DOMAIN=tsec.edu   (leave empty to allow any email)
ALLOWED_EMAIL_DOMAIN=

# ---------------------------------------------------------------------
#  Email (for OTP codes and placement notifications)
#  Gmail setup (5 minutes):
#   1. Use a Gmail account for the placement cell (e.g. tsecplacements@gmail.com)
#   2. Turn on 2-Step Verification:  https://myaccount.google.com/security
#   3. Create an App password:       https://myaccount.google.com/apppasswords
#      (name it "TSEC Portal"). Google shows a 16-letter password.
#   4. Put the Gmail address in SMTP_USER and the 16 letters in SMTP_PASS.
#  If SMTP_USER is empty, emails are printed in the terminal instead
#  (useful for testing without internet).
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TSEC Placement Cell <your-gmail@gmail.com>

# Also email students when they are verified, assigned, shortlisted, selected…
EMAIL_NOTIFICATIONS=true

# Address used for the "Open the portal" button inside emails.
# If students open the portal from other computers on the college Wi-Fi,
# put this laptop's address here, e.g. http://192.168.1.25:3000
PUBLIC_URL=http://localhost:3000
